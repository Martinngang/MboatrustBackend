# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:8443,http://localhost:5173,http://127.0.0.1:8443
APP_BASE_URL=http://localhost:5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/mboatrust

# Firebase Admin
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Dev-only auth bypass
DEV_AUTH_BYPASS=true

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# MTN MoMo Sandbox
MOMO_SANDBOX_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_DISBURSEMENT_SUBSCRIPTION_KEY=

# Orange Money Web Payment Sandbox
OM_SANDBOX_BASE_URL=https://api.orange.com/orange-money-webpay/dev/v1
OM_MERCHANT_KEY=
OM_CLIENT_ID=
OM_CLIENT_SECRET=

# Stripe (international collection)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Flutterwave (international collection)
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

# Smile Identity (KYC sandbox)
SMILE_ID_PARTNER_ID=
SMILE_ID_API_KEY=
SMILE_ID_SANDBOX=true

# Gemini (AI second-opinion layer on fraud checks + contractor match rationale — optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
AI_FRAUD_ANALYSIS_ENABLED=true
AI_MATCHING_RATIONALE_ENABLED=true
