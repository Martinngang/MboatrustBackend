# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:8443,http://localhost:5173,http://127.0.0.1:8443
APP_BASE_URL=http://localhost:5000
# Number of trusted reverse-proxy hops in front of this app (Render, Heroku,
# Railway, a single nginx hop are all "1"). Leave blank for a direct/no-proxy
# setup. Required in production behind a proxy — otherwise rate limiting
# buckets every user together under one shared limit (see src/config/env.js).
TRUST_PROXY=

# MongoDB
MONGODB_URI=mongodb://localhost:27017/mboatrust

# Firebase Admin
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Dev-only auth bypass
DEV_AUTH_BYPASS=true

# One-time admin bootstrap — set to an already-registered account's email,
# restart the server once, and that account gets the 'admin' role (granting
# it normally requires an existing admin, so a fresh database has no other
# path to its first one). Safe to leave set — later restarts are a no-op.
INITIAL_ADMIN_EMAIL=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# MTN MoMo Sandbox
MOMO_SANDBOX_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_DISBURSEMENT_SUBSCRIPTION_KEY=

# Orange Money Web Payment Sandbox
OM_SANDBOX_BASE_URL=https://api.orange.com/orange-money-webpay/dev/v1
OM_MERCHANT_KEY=
OM_CLIENT_ID=
OM_CLIENT_SECRET=

# Stripe (international collection)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Flutterwave (international collection)
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

# Smile Identity (KYC sandbox)
SMILE_ID_PARTNER_ID=
SMILE_ID_API_KEY=
SMILE_ID_SANDBOX=true

# Gemini (AI second-opinion layer on fraud checks + contractor match rationale — optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
AI_FRAUD_ANALYSIS_ENABLED=true
AI_MATCHING_RATIONALE_ENABLED=true

# Transactional email (SMTP) — bootstrap default only. Once an admin saves
# settings through the Admin dashboard's SMTP Settings screen, the database
# takes over as the source of truth and these are ignored (see
# src/services/smtpSettingsService.js).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Encrypts the SMTP password an admin saves via the dashboard at rest in
# MongoDB (AES-256-GCM) — required before that screen can save a password.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SETTINGS_ENCRYPTION_KEY=
